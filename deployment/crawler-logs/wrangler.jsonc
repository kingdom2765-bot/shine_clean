{
  "name": "wonnae-crawler-logs",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "www.wonnaecare.co.kr/*", "zone_name": "wonnaecare.co.kr" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
